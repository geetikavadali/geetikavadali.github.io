{%- comment -%}
  Flippable sketchbook. Every page image is fetched once, up front (a few at a
  time, nearest spread first) and decoded before it can be shown, so turning a
  page never waits on the network. See _data/sketches.yml for the spreads.
{%- endcomment -%}
{%- assign sb_first = site.data.sketches.first -%}
{%- if sb_first.image -%}
  <link rel="preload" as="image" href="{{ sb_first.image }}" fetchpriority="high">
{%- else -%}
  {%- if sb_first.left -%}
    <link rel="preload" as="image" href="{{ sb_first.left }}" fetchpriority="high">
  {%- endif -%}
  {%- if sb_first.right -%}
    <link rel="preload" as="image" href="{{ sb_first.right }}" fetchpriority="high">
  {%- endif -%}
{%- endif -%}
<div class="sketchbook">
  {% for s in site.data.sketches %}
    <template
      class="sb-src"
      data-image="{{ s.image }}"
      data-left="{{ s.left }}"
      data-right="{{ s.right }}"
      data-title="{{ s.title }}"
      data-w="{{ s.w | default: 1280 }}"
      data-h="{{ s.h | default: 720 }}"
    ></template>
  {% endfor %}
  <div class="sb-stage">
    <button class="sb-arrow sb-prev" type="button" aria-label="previous spread">
      <svg viewBox="0 0 14 44" width="14" height="44" fill="none" aria-hidden="true">
        <polyline
          points="11,3 3,22 11,41"
          stroke="currentColor"
          stroke-width="1.1"
          stroke-linecap="round"
          stroke-linejoin="round"></polyline>
      </svg>
    </button>
    <div class="sb-book">
      <div class="sb-base">
        <div class="sb-half sb-half-l"><img class="sb-img" alt="" decoding="async" draggable="false"></div>
        <div class="sb-half sb-half-r"><img class="sb-img" alt="" decoding="async" draggable="false"></div>
      </div>
      <div class="sb-cast sb-cast-left"></div>
      <div class="sb-cast sb-cast-right"></div>
      <div class="sb-sheet is-hidden">
        <div class="sb-face sb-front"><img class="sb-img" alt="" decoding="async" draggable="false"></div>
        <div class="sb-face sb-back"><img class="sb-img" alt="" decoding="async" draggable="false"></div>
        <div class="sb-shade"></div>
      </div>
      <div class="sb-wait" aria-hidden="true"></div>
      <button class="sb-zone sb-zone-prev" type="button" tabindex="-1" aria-hidden="true"></button>
      <button class="sb-zone sb-zone-next" type="button" tabindex="-1" aria-hidden="true"></button>
      <div class="sb-progress" aria-hidden="true"><span></span></div>
    </div>
    <button class="sb-arrow sb-next" type="button" aria-label="next spread">
      <svg viewBox="0 0 14 44" width="14" height="44" fill="none" aria-hidden="true">
        <polyline
          points="3,3 11,22 3,41"
          stroke="currentColor"
          stroke-width="1.1"
          stroke-linecap="round"
          stroke-linejoin="round"></polyline>
      </svg>
    </button>
  </div>
  <p class="sb-caption" aria-live="polite">{{ site.data.sketches.first.title }}</p>
</div>
<script>
  (function () {
    var root = document.querySelector('.sketchbook');
    if (!root) return;

    var spreads = Array.prototype.map.call(root.querySelectorAll('.sb-src'), function (t) {
      var spread = {
        image: t.dataset.image,
        left: t.dataset.left,
        right: t.dataset.right,
        title: t.dataset.title,
        w: parseInt(t.dataset.w, 10),
        h: parseInt(t.dataset.h, 10),
        urls: [],
        pending: 0,
      };
      if (spread.image) spread.urls.push(spread.image);
      else {
        if (spread.left) spread.urls.push(spread.left);
        if (spread.right) spread.urls.push(spread.right);
      }
      spread.pending = spread.urls.length;
      return spread;
    });
    if (!spreads.length) return;

    var book = root.querySelector('.sb-book');
    var baseL = root.querySelector('.sb-half-l');
    var baseR = root.querySelector('.sb-half-r');
    var sheet = root.querySelector('.sb-sheet');
    var front = sheet.querySelector('.sb-front');
    var back = sheet.querySelector('.sb-back');
    var caption = root.querySelector('.sb-caption');
    var prevBtn = root.querySelector('.sb-arrow.sb-prev');
    var nextBtn = root.querySelector('.sb-arrow.sb-next');
    var zonePrev = root.querySelector('.sb-zone-prev');
    var zoneNext = root.querySelector('.sb-zone-next');
    var bar = root.querySelector('.sb-progress span');

    // ---- preloading -----------------------------------------------------
    // Each page is fetched once and decoded up front, a few at a time, so no
    // flip ever waits on the network. Anything the reader asks for jumps the
    // queue; anything already fetched is shown straight away.
    var MAX_PARALLEL = 3;
    var status = {};
    var held = []; // keep the loaded pages alive for the whole session
    var queue = [];
    var inflight = 0;
    var settled = 0;
    var allUrls = [];

    spreads.forEach(function (s) {
      s.urls.forEach(function (url) {
        if (allUrls.indexOf(url) === -1) allUrls.push(url);
      });
    });

    function report() {
      if (!allUrls.length) {
        root.classList.add('sb-loaded');
        return;
      }
      if (bar) bar.style.width = Math.round((settled / allUrls.length) * 100) + '%';
      if (settled >= allUrls.length) root.classList.add('sb-loaded');
    }

    function settle(url, ok) {
      if (status[url] === 'ready' || status[url] === 'error') return;
      status[url] = ok ? 'ready' : 'error';
      inflight--;
      settled++;
      if (!ok) console.warn('sketchbook: could not load ' + url);
      spreads.forEach(function (s) {
        if (s.pending && s.urls.indexOf(url) !== -1) s.pending--;
      });
      if (ok) reveal(url);
      report();
      pump();
      syncChrome();
      flushPending();
    }

    function load(url) {
      if (status[url]) return;
      status[url] = 'loading';
      inflight++;
      var im = new Image();
      held.push(im);
      im.decoding = 'async';
      function done() {
        settle(url, true);
      }
      im.onload = function () {
        // decoding now keeps the main thread free when the page turns
        if (im.decode) im.decode().then(done, done);
        else done();
      };
      im.onerror = function () {
        settle(url, false);
      };
      im.src = url;
    }

    function pump() {
      while (queue.length && inflight < MAX_PARALLEL) load(queue.shift());
    }

    function preload(url) {
      if (status[url] || queue.indexOf(url) !== -1) return;
      queue.push(url);
      pump();
    }

    function demand(url) {
      if (status[url]) return;
      var at = queue.indexOf(url);
      if (at !== -1) queue.splice(at, 1);
      load(url);
    }

    function demandSpread(s) {
      s.urls.forEach(demand);
    }

    function reveal(url) {
      var imgs = root.querySelectorAll('.sb-img');
      for (var i = 0; i < imgs.length; i++) {
        if (imgs[i].getAttribute('data-sb-url') === url) imgs[i].classList.add('is-ready');
      }
    }

    // nearest spreads first, so the page being read and the ones right after
    // it arrive before the rest of the book
    function preloadAround(center) {
      for (var d = 1; d < spreads.length; d++) {
        if (center + d < spreads.length) spreads[center + d].urls.forEach(preload);
        if (center - d >= 0) spreads[center - d].urls.forEach(preload);
      }
    }

    // ---- painting -------------------------------------------------------
    // `side` is where the half sits in the book: the left page of a spread is
    // shown by the left half (and by the back of the turning sheet), the right
    // page by the right half.
    function paint(el, s, side) {
      var img = el.firstElementChild;
      var url = s.image || (side === 'left' ? s.left : s.right);
      if (!url) {
        img.classList.remove('is-ready', 'is-inst');
        img.removeAttribute('src');
        img.removeAttribute('data-sb-url');
        return;
      }
      if (s.image) {
        // a single wide spread image: crop it to the half this side shows
        img.style.width = '200%';
        img.style.left = side === 'left' ? '0' : 'auto';
        img.style.right = side === 'right' ? '0' : 'auto';
      } else {
        img.style.width = '100%';
        img.style.left = '0';
        img.style.right = 'auto';
      }
      if (img.getAttribute('data-sb-url') === url) return;
      // a page that is already decoded can appear at once; one that still has
      // to arrive fades in when it does (see reveal)
      var here = status[url] === 'ready';
      img.classList.toggle('is-inst', here);
      img.setAttribute('data-sb-url', url);
      img.classList.toggle('is-ready', here);
      img.setAttribute('src', url);
    }

    function setSpreadHalves(s) {
      paint(baseL, s, 'left');
      paint(baseR, s, 'right');
    }

    // ---- motion-blur filter defs (built via DOM so kramdown cannot lowercase them)
    var svgns = 'http://www.w3.org/2000/svg';
    var svg = document.createElementNS(svgns, 'svg');
    svg.setAttribute('width', '0');
    svg.setAttribute('height', '0');
    svg.style.position = 'absolute';
    svg.setAttribute('aria-hidden', 'true');
    ['1:4 0', '2:10 0'].forEach(function (spec) {
      var parts = spec.split(':');
      var filter = document.createElementNS(svgns, 'filter');
      filter.setAttribute('id', 'sb-mblur-' + parts[0]);
      var blur = document.createElementNS(svgns, 'feGaussianBlur');
      blur.setAttribute('stdDeviation', parts[1]);
      filter.appendChild(blur);
      svg.appendChild(filter);
    });
    root.insertBefore(svg, root.firstChild);

    var DURATION = 720;
    var EASING = 'cubic-bezier(0.55, 0.06, 0.35, 1)';
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) DURATION = 0;

    var index = 0;
    var flipping = false;
    var pendingDir = 0;
    var timers = [];

    function later(fn, t) {
      timers.push(setTimeout(fn, t));
    }

    function updateChrome() {
      var first = index === 0;
      var last = index === spreads.length - 1;
      [prevBtn, zonePrev].forEach(function (el) {
        el.classList.toggle('is-disabled', first);
        el.setAttribute('aria-disabled', first ? 'true' : 'false');
      });
      [nextBtn, zoneNext].forEach(function (el) {
        el.classList.toggle('is-disabled', last);
        el.setAttribute('aria-disabled', last ? 'true' : 'false');
      });
      prevBtn.disabled = first;
      nextBtn.disabled = last;
    }

    // the spinner covers the page still on its way (or the very first one)
    function syncChrome() {
      var busy = !!pendingDir || spreads[index].pending > 0;
      root.classList.toggle('is-loading', busy);
      book.setAttribute('aria-busy', busy ? 'true' : 'false');
    }

    function setCaption(text) {
      if (caption.textContent === text) return;
      caption.classList.add('is-fading');
      setTimeout(function () {
        caption.textContent = text;
        caption.classList.remove('is-fading');
      }, 180);
    }

    function finalize(target) {
      index = target;
      setSpreadHalves(spreads[index]);
      sheet.style.transition = 'none';
      sheet.style.transform = 'rotateY(0deg)';
      sheet.classList.remove('sb-dir-next', 'sb-dir-prev', 'sb-blur-1', 'sb-blur-2');
      sheet.classList.add('is-hidden');
      root.classList.remove('sb-casting-left', 'sb-casting-right');
      flipping = false;
      updateChrome();
      syncChrome();
      // keep the page the reader is heading towards loaded first
      if (index + 1 < spreads.length) demandSpread(spreads[index + 1]);
      flushPending();
    }

    function runFlip(dir) {
      var target = index + dir;
      flipping = true;

      if (dir === 1) {
        paint(front, spreads[index], 'right');
        paint(back, spreads[target], 'left');
        sheet.style.transition = 'none';
        sheet.style.transform = 'rotateY(0deg)';
      } else {
        paint(front, spreads[target], 'right');
        paint(back, spreads[index], 'left');
        sheet.style.transition = 'none';
        sheet.style.transform = 'rotateY(-180deg)';
      }

      sheet.classList.remove('is-hidden');
      sheet.classList.remove('sb-dir-next', 'sb-dir-prev', 'sb-blur-1', 'sb-blur-2');
      sheet.classList.add(dir === 1 ? 'sb-dir-next' : 'sb-dir-prev');
      void sheet.offsetWidth;

      sheet.style.transition = 'transform ' + DURATION + 'ms ' + EASING;
      sheet.style.transform = dir === 1 ? 'rotateY(-180deg)' : 'rotateY(0deg)';

      later(function () {
        setSpreadHalves(spreads[target]);
        setCaption(spreads[target].title);
        root.classList.remove('sb-casting-left', 'sb-casting-right');
        root.classList.add(dir === 1 ? 'sb-casting-left' : 'sb-casting-right');
      }, DURATION / 2);

      later(function () {
        sheet.classList.add('sb-blur-2');
      }, DURATION * 0.28);
      later(function () {
        sheet.classList.remove('sb-blur-2');
        sheet.classList.add('sb-blur-1');
      }, DURATION * 0.5);
      later(function () {
        sheet.classList.remove('sb-blur-1');
      }, DURATION * 0.78);

      var done = false;
      function finish() {
        if (done) return;
        done = true;
        sheet.removeEventListener('transitionend', finish);
        finalize(target);
      }
      sheet.addEventListener('transitionend', finish);
      later(finish, DURATION + 140);
    }

    function apply(dir) {
      var target = index + dir;
      if (reduced) {
        index = target;
        setSpreadHalves(spreads[index]);
        caption.textContent = spreads[index].title;
        updateChrome();
        syncChrome();
        if (index + 1 < spreads.length) demandSpread(spreads[index + 1]);
        return;
      }
      runFlip(dir);
    }

    function flip(dir) {
      if (flipping) return;
      var target = index + dir;
      if (target < 0 || target >= spreads.length) return;

      if (spreads[target].pending) {
        // that page is still on its way: hold the turn until it can be shown
        pendingDir = dir;
        demandSpread(spreads[target]);
        syncChrome();
        return;
      }

      pendingDir = 0;
      syncChrome();
      apply(dir);
    }

    // a turn that was waiting on an image starts as soon as the image is here
    function flushPending() {
      if (!pendingDir || flipping) return;
      var dir = pendingDir;
      var target = index + dir;
      if (target < 0 || target >= spreads.length || spreads[target].pending) return;
      pendingDir = 0;
      syncChrome();
      apply(dir);
    }

    zonePrev.addEventListener('click', function () {
      flip(-1);
    });
    zoneNext.addEventListener('click', function () {
      flip(1);
    });
    prevBtn.addEventListener('click', function () {
      flip(-1);
    });
    nextBtn.addEventListener('click', function () {
      flip(1);
    });

    var startX = null;
    book.addEventListener('pointerdown', function (e) {
      startX = e.clientX;
    });
    book.addEventListener('pointerup', function (e) {
      if (startX === null) return;
      var dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 45) flip(dx < 0 ? 1 : -1);
    });

    document.addEventListener('keydown', function (e) {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      var t = e.target;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
      if (e.key === 'ArrowRight') flip(1);
      else if (e.key === 'ArrowLeft') flip(-1);
    });

    book.style.aspectRatio = spreads[0].w + ' / ' + spreads[0].h;
    setSpreadHalves(spreads[0]);
    updateChrome();
    report();
    syncChrome();
    spreads[0].urls.forEach(demand);
    preloadAround(0);
  })();
</script>
